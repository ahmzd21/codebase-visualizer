{
  "name": "codebase-visualizer-api",
  "version": "1.0.0",
  "description": "REST API for Codebase Visualizer - Developer Insight Tool",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "node server.js"
  },
  "dependencies": {
    "@babel/traverse": "^8.0.0",
    "@bull-board/api": "^8.0.1",
    "@bull-board/express": "^8.0.1",
    "@bull-board/ui": "^8.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "ioredis": "^5.11.1",
    "java-parser": "^3.0.1",
    "jsonwebtoken": "^9.0.2",
    "lang-map": "^0.4.0",
    "mime-types": "^3.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.0.2"
  }
}
